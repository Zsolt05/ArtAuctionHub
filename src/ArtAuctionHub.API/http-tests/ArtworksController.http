# HTTP test file for ArtworksController
@id = 1
@categoryId = 1

POST http://localhost:5000/api/artworks
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="title"

Mona Lisa
--boundary
Content-Disposition: form-data; name="codeName"

mona-lisa
--boundary
Content-Disposition: form-data; name="description"

Famous painting.
--boundary
Content-Disposition: form-data; name="imageUrl"

https://example.com/image.jpg
--boundary
Content-Disposition: form-data; name="isAdultOnly"

false
--boundary
Content-Disposition: form-data; name="categoryId"

1
--boundary
Content-Disposition: form-data; name="imageFile"; filename="mona-lisa.jpg"
Content-Type: image/jpeg

< ./images/mona-lisa.jpg
--boundary--

###

PUT http://localhost:5000/api/artworks/{{id}}
Content-Type: application/json

{
  "title": "Updated Title",
  "codeName": "updated-code",
  "description": "Updated description.",
  "imageUrl": "https://example.com/updated.jpg",
  "isAdultOnly": false,
  "categoryId": {{categoryId}}
}

###

DELETE http://localhost:5000/api/artworks/{{id}}

###

GET http://localhost:5000/api/artworks

###

GET http://localhost:5000/api/artworks/my
