# HTTP test file for ArtworksController
@id = 1
@categoryId = 1

### Create artwork
POST {{host}}/api/artworks
Authorization: Bearer {{jwt_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="title"

Mona Lisa
--boundary
Content-Disposition: form-data; name="codeName"

mona-lisa
--boundary
Content-Disposition: form-data; name="description"

Famous painting.
--boundary
Content-Disposition: form-data; name="imageUrl"

https://example.com/image.jpg
--boundary
Content-Disposition: form-data; name="isAdultOnly"

false
--boundary
Content-Disposition: form-data; name="categoryId"

1
--boundary
Content-Disposition: form-data; name="imageFile"; filename="mona-lisa.jpg"
Content-Type: image/jpeg

< ./images/mona-lisa.jpg
--boundary--

###

### Update artwork
PUT {{host}}/api/artworks/{{id}}
Authorization: Bearer {{jwt_token}}
Content-Type: application/json

{
  "title": "Updated Title",
  "codeName": "updated-code",
  "description": "Updated description.",
  "imageUrl": "https://example.com/updated.jpg",
  "isAdultOnly": false,
  "categoryId": {{categoryId}}
}

###

### Delete artwork
DELETE {{host}}/api/artworks/{{id}}
Authorization: Bearer {{jwt_token}}

###

### Get all artworks
GET {{host}}/api/artworks
Authorization: Bearer {{jwt_token}}

###

### Get my artworks
GET {{host}}/api/artworks/my
Authorization: Bearer {{jwt_token}}